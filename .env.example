# Browser configuration (publishable values only).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server connection to the same backend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Parallel hosting: keep private server functions on the existing Lovable host.
# Leave unset in Lovable. No service-role, Groq, or cron secrets are copied to Vercel.
# PAMARA_BACKEND_ORIGIN=https://pamara-bodega.lovable.app

# Full backend hosting only: supply these in the server's secret store.
# SUPABASE_SERVICE_ROLE_KEY=
# GROQ_API_KEY=
# LOVABLE_API_KEY=
# FIREBASE_MESSAGING_API_KEY=
# LOVABLE_CRON_SECRET=
